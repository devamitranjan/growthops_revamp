{
  "name": "growthops",
  "version": "1.0.0",
  "private": true,
  "author": "Amit Ranjan",
  "contributors": [
    "Ankit Raj"
  ],
  "scripts": {
    "dev": "next dev",
    "cms": "printf '\\n  Studio -> http://localhost:3000/studio\\n\\n' && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "typegen": "cd src/cms/sanity && sanity schemas extract --force && sanity typegen generate",
    "schema:deploy": "cd src/cms/sanity && sanity schemas deploy",
    "sanity": "cd src/cms/sanity && sanity",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sanity/client": "8.4.0",
    "@sanity/vision": "6.11.0",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "^4.1.0",
    "lucide-react": "^1.38.0",
    "next": "16.3.4",
    "next-sanity": "13.3.3",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-fast-marquee": "^1.6.5",
    "react-icons": "^5.7.0",
    "sanity": "6.11.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-check-file": "^3.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@10.17.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "pnpm": {
    "overrides": {
      "js-yaml@3": "^3.15.1",
      "fast-uri": "^3.1.6"
    }
  }
}
