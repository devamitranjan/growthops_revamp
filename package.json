{
  "name": "growthops",
  "version": "1.0.0",
  "private": true,
  "author": "Amit Ranjan",
  "contributors": [
    "Ankit Raj"
  ],
  "scripts": {
    "dev": "next dev",
    "cms": "printf '\\n  Studio -> http://localhost:3000/studio\\n\\n' && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typegen": "cd src/sanity && sanity schemas extract --force && sanity typegen generate",
    "schema:deploy": "cd src/sanity && sanity schemas deploy",
    "sanity": "cd src/sanity && sanity",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sanity/client": "7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/react-loader": "^2.2.1",
    "@sanity/vision": "6.10.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-sanity": "13.3.3",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-fast-marquee": "^1.6.5",
    "react-icons": "^5.7.0",
    "sanity": "6.10.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-check-file": "^3.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.17.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "pnpm": {
    "overrides": {
      "js-yaml@3": "^3.15.1"
    }
  }
}
